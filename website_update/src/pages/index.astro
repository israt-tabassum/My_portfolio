---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import fjord from '../assets/fjord.jpg';
import usn from '../assets/usn.png';
import ndub from '../assets/ndub.png';
import {
  profile,
  publications,
  experience,
  projects,
  education,
  skills,
  languages,
} from '../data/profile';

const logos = { usn, ndub };
const ext = { target: '_blank', rel: 'noopener noreferrer' };
const year = new Date().getFullYear();
---

<Base>
  <Header />

  <main id="top">
    <!-- Hero -->
    <section class="hero">
      <Image
        src={fjord}
        alt=""
        class="hero-bg"
        widths={[640, 1000]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero-shade"></div>
      <div class="container hero-content">
        <h1>{profile.name}</h1>
        <div class="actions">
          <a class="btn primary" href="#research">View publications</a>
          <a class="btn ghost" href={`mailto:${profile.links.email}`}>Get in touch</a>
        </div>
      </div>
    </section>

    <!-- About -->
    <section id="about" class="section">
      <div class="container about">
        <div class="section-head">
          <span class="num">01</span>
          <h2>About</h2>
        </div>
        <div class="about-text">
          {profile.about.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>

    <!-- Research -->
    <section id="research" class="section">
      <div class="container">
        <div class="section-head">
          <span class="num">02</span>
          <h2>Publications</h2>
        </div>
        <ol class="pubs">
          {
            publications.map((pub) => (
              <li class="pub">
                <span class="pub-year">{pub.year ?? '—'}</span>
                <div>
                  <h3>
                    <a href={pub.url} {...ext}>
                      {pub.title}
                    </a>
                  </h3>
                  <p class="pub-meta">
                    {pub.authors} · <em>{pub.venue}</em>
                  </p>
                  <p class="pub-summary">{pub.summary}</p>
                  <ul class="tags">
                    {pub.tags.map((t) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Experience -->
    <section id="experience" class="section">
      <div class="container">
        <div class="section-head">
          <span class="num">03</span>
          <h2>Experience</h2>
        </div>
        <ol class="timeline">
          {
            experience.map((job) => (
              <li>
                <span class="period">{job.period}</span>
                <div>
                  <h3>{job.role}</h3>
                  <p class="org">
                    {job.url ? (
                      <a href={job.url} {...ext}>
                        {job.org}
                      </a>
                    ) : (
                      job.org
                    )}
                  </p>
                  <p class="desc">{job.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Projects -->
    <section id="projects" class="section">
      <div class="container">
        <div class="section-head">
          <span class="num">04</span>
          <h2>Selected projects</h2>
        </div>
        <div class="grid">
          {
            projects.map((p) => (
              <article class="card project">
                <h3>{p.title}</h3>
                <p>{p.description}</p>
                <ul class="tags">
                  {p.tags.map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
        <p class="more">
          More on <a href={profile.links.github} {...ext}>GitHub</a>.
        </p>
      </div>
    </section>

    <!-- Education & skills -->
    <section id="education" class="section">
      <div class="container">
        <div class="section-head">
          <span class="num">05</span>
          <h2>Education &amp; skills</h2>
        </div>
        <div class="edu-grid">
          {
            education.map((e) => (
              <article class="card edu">
                <div class="edu-logo">
                  {e.logo ? (
                    <Image src={logos[e.logo]} alt={`${e.school} logo`} width={56} height={56} />
                  ) : (
                    <span aria-hidden="true">NTNU</span>
                  )}
                </div>
                <div>
                  <p class="period">{e.period}</p>
                  <h3>{e.degree}</h3>
                  <p>
                    <a href={e.url} {...ext}>
                      {e.school}
                    </a>
                  </p>
                  {e.detail && <p class="muted">{e.detail}</p>}
                </div>
              </article>
            ))
          }
        </div>

        <div class="skills">
          {
            skills.map((s) => (
              <div>
                <h3>{s.group}</h3>
                <ul class="tags">
                  {s.items.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div>
            <h3>Languages</h3>
            <ul class="langs">
              {
                languages.map((l) => (
                  <li>
                    <span>{l.name}</span>
                    <span class="muted">{l.level}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="section contact">
      <div class="container">
        <div class="section-head">
          <span class="num">06</span>
          <h2>Contact</h2>
        </div>
        <p class="contact-lede">
          Open to research collaborations, talks and conversations about deep learning. The
          quickest way to reach me is by email.
        </p>
        <a class="email" href={`mailto:${profile.links.email}`}>{profile.links.email}</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <p>© {year} {profile.name}</p>
    </div>
  </footer>
</Base>

<style>
  /* Hero */
  .hero {
    position: relative;
    min-height: min(88vh, 760px);
    display: flex;
    align-items: flex-end;
    color: var(--hero-ink);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(8 20 19 / 0.15) 0%, rgb(8 20 19 / 0.8) 100%);
  }
  .hero-content {
    position: relative;
    padding-bottom: 4.5rem;
    padding-top: 6rem;
  }
  .hero h1 {
    font-size: clamp(2.75rem, 9vw, 5.5rem);
    margin: 0;
    font-weight: 500;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: transform 0.15s ease;
  }
  .btn:hover {
    transform: translateY(-1px);
  }
  .btn.primary {
    background: #fff;
    color: #0b2f2d;
  }
  .btn.ghost {
    color: #fff;
    border: 1px solid rgb(255 255 255 / 0.6);
  }
  .btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  /* About */
  .about-text {
    display: grid;
    gap: 1.1rem;
    font-size: 1.1rem;
    max-width: 48rem;
  }
  .period {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .skills h3 {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  /* Publications */
  .pubs {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pub {
    display: grid;
    gap: 0.5rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--line);
  }
  .pub:first-child {
    padding-top: 0;
  }
  .pub-year {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--accent);
  }
  .pub h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .pub h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .pub h3 a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .pub-meta {
    color: var(--muted);
    font-size: 0.92rem;
    margin-bottom: 0.6rem;
  }
  .pub-summary {
    margin-bottom: 0.9rem;
    max-width: 48rem;
  }
  .more {
    margin-top: 1.75rem;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* Timeline */
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.75rem;
  }
  .timeline li {
    display: grid;
    gap: 0.3rem;
    padding-left: 1.25rem;
    border-left: 2px solid var(--line);
  }
  .timeline li:first-child {
    border-left-color: var(--accent);
  }
  .timeline h3 {
    font-size: 1.2rem;
  }
  .org {
    font-weight: 500;
  }
  .org a {
    text-decoration: none;
  }
  .desc,
  .muted {
    color: var(--muted);
  }

  /* Projects */
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .project {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .project h3 {
    font-size: 1.15rem;
  }
  .project p {
    color: var(--muted);
    font-size: 0.97rem;
    flex: 1;
  }

  /* Education */
  .edu-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
  }
  .edu {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }
  .edu h3 {
    font-size: 1.1rem;
    margin: 0.2rem 0 0.3rem;
  }
  .edu a {
    text-decoration: none;
  }
  .edu .muted {
    font-size: 0.92rem;
    margin-top: 0.2rem;
  }
  .edu-logo {
    flex: none;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: #fff;
    border: 1px solid var(--line);
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .edu-logo img {
    object-fit: contain;
    width: 100%;
    height: 100%;
    padding: 4px;
  }
  .edu-logo span {
    font-size: 0.7rem;
    font-weight: 700;
    color: #00509e;
    letter-spacing: 0.04em;
  }
  .skills {
    display: grid;
    gap: 2rem;
    margin-top: 3rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr));
  }
  .langs {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
    font-size: 0.95rem;
  }
  .langs li {
    display: flex;
    justify-content: space-between;
    border-bottom: 1px dashed var(--line);
    padding-bottom: 0.3rem;
  }

  /* Contact */
  .contact-lede {
    max-width: 36rem;
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }
  .email {
    font-family: var(--font-serif);
    font-size: clamp(1.4rem, 5vw, 2.4rem);
    word-break: break-word;
  }
  .footer {
    border-top: 1px solid var(--line);
    padding: 2rem 0;
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (min-width: 820px) {
    .pub {
      grid-template-columns: 5rem 1fr;
      gap: 1.5rem;
    }
    .timeline li {
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem;
    }
  }
</style>
