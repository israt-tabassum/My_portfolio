---
import Base from '../layouts/Base.astro';
import { profile } from '../data/profile';

const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Base title={`Page not found — ${profile.name}`} description="This page could not be found.">
  <main class="nf container">
    <p class="code">404</p>
    <h1>Page not found</h1>
    <p>The page you were looking for doesn't exist or has moved.</p>
    <a class="home" href={home}>← Back to {profile.name}</a>
  </main>
</Base>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }
  .code {
    font-family: var(--font-serif);
    font-size: clamp(4rem, 15vw, 8rem);
    line-height: 1;
    color: var(--accent);
  }
  h1 {
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }
  p {
    color: var(--muted);
  }
  .home {
    font-weight: 600;
    margin-top: 0.5rem;
  }
</style>
