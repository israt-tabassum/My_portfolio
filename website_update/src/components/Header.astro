---
import { profile } from '../data/profile';

const nav = [
  { href: '#about', label: 'About' },
  { href: '#research', label: 'Research' },
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#education', label: 'Education' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="#top" class="brand">{profile.name}</a>

    <nav aria-label="Primary" class="desktop">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <!-- JS-free mobile menu -->
    <details class="mobile">
      <summary aria-label="Menu">
        <span></span><span></span><span></span>
      </summary>
      <nav aria-label="Mobile">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
    </details>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
  }
  .brand {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text);
    text-decoration: none;
  }
  .desktop {
    display: none;
    gap: 1.75rem;
  }
  .desktop a,
  .mobile nav a {
    color: var(--muted);
    text-decoration: none;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .desktop a:hover,
  .mobile nav a:hover {
    color: var(--accent);
  }

  .mobile summary {
    list-style: none;
    cursor: pointer;
    display: grid;
    gap: 5px;
    padding: 0.6rem;
  }
  .mobile summary::-webkit-details-marker {
    display: none;
  }
  .mobile summary span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--text);
    border-radius: 2px;
  }
  .mobile nav {
    position: absolute;
    left: 0;
    right: 0;
    top: 4rem;
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 0.5rem 1rem 1rem;
  }
  .mobile nav a {
    padding: 0.7rem 0;
    font-size: 1rem;
  }

  @media (min-width: 820px) {
    .desktop {
      display: flex;
    }
    .mobile {
      display: none;
    }
  }
</style>
